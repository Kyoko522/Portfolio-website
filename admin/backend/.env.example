# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000

# Where the admin SPA is served from (used to lock down CORS).
# In dev the Vite proxy makes this same-origin, but this is the allowed origin
# if the frontend ever calls the API cross-origin.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Postgres. From Supabase -> Project Settings -> Database -> Connection
# string. DATABASE_URL is the app connection; DIRECT_URL is used for migrations.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Auth -----------------------------------------------------------------------
# Generate a strong secret, e.g.:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# How long a login session lasts.
JWT_EXPIRES_IN=7d
# Seeded admin account (used by `npm run db:seed`). Change before seeding.
ADMIN_EMAIL=sheelpatel5252@gmail.com
ADMIN_PASSWORD=change-me-strong-password

# Claude API -----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model used for cover-letter generation. Opus 4.7 is the most capable; switch
# to claude-sonnet-4-6 for lower cost if you prefer.
COVER_LETTER_MODEL=claude-opus-4-7
# Model used for the résumé tailoring pipeline (assemble/Scanner/Surgeon/Stress
# Test). Opus gives the best rewrites; drop to claude-sonnet-4-6 for lower cost.
RESUME_MODEL=claude-opus-4-7

# Publishing -----------------------------------------------------------------
# Absolute or relative path to the published PDF the public site links to.
# Default points at the portfolio's public/assets dir (repo root).
PUBLISH_PDF_PATH=../../public/assets/Resume.pdf
# Set to "true" to actually run git commit/push on publish. When false, publish
# writes the PDF but skips git (useful for testing).
PUBLISH_GIT_ENABLED=false
